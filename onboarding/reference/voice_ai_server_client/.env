YONO_SERVER_URL=https://dreamboat-bleep-childhood.ngrok-free.dev/voice

# Copy from the server's own .env (voice_ai_server/.env -> YONO_SERVER_API_KEY=...)
YONO_SERVER_API_KEY=VWIyaCk-SG9xaTMsvmH6ATXnrA6fZTA5ZBV8NijBALs

# Must match the server's YONO_SERVER_SAMPLE_RATE / YONO_SERVER_FRAME_MS (defaults shown)
YONO_CLIENT_SAMPLE_RATE=16000
YONO_CLIENT_FRAME_MS=30
