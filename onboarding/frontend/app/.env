# Fallback used only when running `npm run dev` directly.
# run_react.bat overrides this from the repo-root ports.config (BACKEND_PORT).
VITE_API_BASE=http://localhost:8000

# FinGuru uses a SEPARATE backend (hosted agent), independent of the
# onboarding API above. Update these when the ngrok tunnel/key rotates.
# Pointed at the LOCAL backend (see /backend/main.py's /agents/{id}/invoke)
# because the ngrok tunnel above (ominous-ripening-droplet) is offline
# (ERR_NGROK_3200) -- swap back to a hosted URL/key if/when that's redeployed.
# Relative, so it resolves against whatever origin the page is served from and
# is proxied to the backend by vite.config.js. An absolute http://localhost URL
# only works in a browser on this machine -- over a tunnel or from a phone,
# "localhost" is the viewer's own device, and an https page calling http is
# blocked as mixed content anyway.
VITE_FINGURU_URL=/agents/finguru/invoke
VITE_FINGURU_KEY=vosIlgHFBvlN6JvEs2Vsv_sa-vjAPE2k

# Voice server (reference voice_ai_server_client). Used ONLY by the Vite dev
# proxy in vite.config.js -- no VITE_ prefix, so the key is never bundled into
# the client. The browser calls same-origin /voice-api/* (REST) and
# /voice-ws (WebSocket). Update on rotation.
VOICE_SERVER_TARGET=https://dreamboat-bleep-childhood.ngrok-free.dev
VOICE_SERVER_KEY=VWIyaCk-SG9xaTMsvmH6ATXnrA6fZTA5ZBV8NijBALs
# Path of the streaming-TTS WebSocket on the voice server (Prompt 3). The
# browser hits same-origin /tts-ws; Vite proxies it here with the token.
VOICE_TTS_STREAM_PATH=/voice/tts/stream

# Sarvam AI API key. Used ONLY by the Vite dev proxy (/sarvam-api,
# /sarvam-stt-ws in vite.config.js) -- no VITE_ prefix, so it's never bundled
# into the client. Called directly (api.sarvam.ai), NOT through the voice
# server -- its outbound path to Sarvam fails there (corporate TLS-inspection
# proxy on that machine rejects Sarvam's cert chain). Update on rotation.
SARVAM_API_KEY=sk_r0xg4m0a_Q1nMrfFvWsXGRAyd5JOHX0WS

# Voice assistant mode in the FinGuru chat:
#   turn = record -> transcribe -> ask FinGuru -> synthesize -> play (default)
#   live = full-duplex mic stream straight to Sarvam's realtime STT
#          (saaras:v3-realtime, see hooks/useVoiceCall.js) -- STT-only, so
#          replies always come from FinGuru/Ollama, never the voice server.
VITE_VOICE_MODE=live

# Live mode only: when true, skip FinGuru as the voice brain (Ollama answers
# instead if USE_OLLAMA_IN_VOICE is also on below; with neither, transcripts
# show with no spoken reply). false = route transcript through FinGuru (default).
VITE_VOICE_SKIP_FINGURU=false

# --- Ollama LLM (fallback brain for voice when the FinGuru server is down) ---
# 1. Connect directly to an Ollama server from the browser. NOTE: the Ollama
#    server must allow this page's origin via OLLAMA_ORIGINS (e.g. OLLAMA_ORIGINS=*).
VITE_OLLAMA_ENABLED=true
# 2. Ollama base URL.
VITE_OLLAMA_URL=https://dreamboat-bleep-childhood.ngrok-free.dev/ollama
# 3. Ollama model name.
VITE_OLLAMA_MODEL=gemma4:12b
# 4. When true (and enabled), answer voice questions with Ollama instead of
#    FinGuru, between STT and TTS -- use this when the FinGuru server is down.
VITE_USE_OLLAMA_IN_VOICE=false

# Barge-in: let the user interrupt assistant speech by talking again while it
# plays (live mode only). false (default) = full-turn-based, no interrupt.
VITE_BARGE_IN_ENABLED=true
# Minimum transcript length (chars) to count as a deliberate interrupt rather
# than noise/a cough -- see the comment in lib/voiceConfig.js for why this is
# text-length-based rather than a true speech-duration/confidence threshold.
VITE_BARGE_IN_MIN_CHARS=4

# Sentence-level LLM -> TTS streaming. Scoped ENTIRELY to the Ollama direct-call
# fallback path (active only when VITE_VOICE_SKIP_FINGURU=true AND
# VITE_USE_OLLAMA_IN_VOICE=true) -- the frontend calls Ollama directly there, so
# sentence-chunking + TTS forwarding must happen client-side. When
# VITE_VOICE_SKIP_FINGURU=false, transcripts go to FinGuru as normal and this
# flag has no effect -- FinGuru-side sentence chunking is a separate concern.
# false (default) = existing flow: full LLM response, one call to /synthesize.
# true = stream Ollama tokens, forward each complete sentence to /tts/stream
# as soon as it's ready.
VITE_LLM_STREAMING_ENABLED=true
# Sentence boundary character class. Tamil/Devanagari danda (।) included.
VITE_LLM_SENTENCE_SPLIT_REGEX=[.!?।]

# Front-end logging verbosity. When false (default), the console shows ONLY the
# 7 timestamped voice-pipeline stages (mic start, sent/received for STT, LLM,
# and TTS -- TTS fires per-sentence while streaming). Set true to also emit the
# full per-request/per-file diagnostic logging used while building the pipeline
# (see src/lib/pipelineLog.js).
VITE_DEBUG_LOGS=false

# When true, each chat bubble (request and response) shows the local time it
# was added, right below the text. Off by default.
VITE_SHOW_MESSAGE_TIMESTAMPS=true

# Savings Quest / "Play & Earn" game -- a separate external web app, embedded
# via iframe on /game (with an "Open in new tab" fallback in case the host
# blocks framing via X-Frame-Options/CSP).
VITE_GAME_URL=https://akilan-veerabatheren-hbt-group-com.solutions.innohub.sbi/game/

# Name-based session identity backend (GET /api/history?name=, POST
# /api/tools/save) -- NOT deployed yet (confirmed). Empty = relative paths
# against this app's own origin (so calls fail harmlessly until a real
# backend exists). Set to a base URL once that backend is available.
VITE_FINGURU_NAME_API_BASE=
