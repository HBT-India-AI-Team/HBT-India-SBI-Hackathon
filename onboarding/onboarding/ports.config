# ============================================================
#  YONO 3.0 - single source of truth for ports.
#  Edit the values below, then run run_app.bat / run_react.bat.
#
#  Format: KEY=VALUE, one per line. Lines starting with # are
#  comments. Do NOT put spaces around the "=" or quote the value.
# ============================================================

# Port the FastAPI backend (uvicorn) listens on.
BACKEND_PORT=8800

# Port the React (Vite) dev server serves the frontend on.
FRONTEND_PORT=5873
