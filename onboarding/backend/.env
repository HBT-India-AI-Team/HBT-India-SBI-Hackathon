# YONO 3.0 backend environment overrides.
# Loaded automatically by backend/config.py via python-dotenv.
#
# Ollama (Phase 8 conversation LLM + Phase 7 vision doc classification).
# Points at the user's real Ollama instance, reachable from the machine
# actually running this backend -- NOT from the dev/build sandbox (that
# sandbox's outbound network allowlist blocks this ngrok domain with a
# 403 blocked-by-allowlist; this is expected there, see
# backend/scripts/check_ollama_connectivity.py to verify from a machine
# that *does* have network access to it).
OLLAMA_BASE_URL=https://dreamboat-bleep-childhood.ngrok-free.dev/ollama

# NOTE: "gemma4:12B" is not a publicly known Ollama model tag as of early
# 2026 (the latest known Gemma line on Ollama is gemma3, e.g. gemma3:12b).
# If "gemma4" is a typo, correct this to gemma3:12b. If it's a real
# custom/local model tag pulled on your Ollama instance, leave it as-is --
# we are not silently changing the value you gave us. Verify with
# `ollama list` on the machine running Ollama, or run
# backend/scripts/check_ollama_connectivity.py against it.
OLLAMA_MODEL=gemma4:12B

# Used by the new classify_document() vision call in doc_parser.py (Phase
# 7 document-type sanity check). Set to the same model unless you have a
# separate vision-specific tag pulled -- same "gemma4 vs gemma3" caveat
# applies here too.
OLLAMA_VISION_MODEL=gemma4:12B

# --- Voice AI server (STT + TTS + live call) ---
# Copied from reference/voice_ai_server_client/.env (that file is
# authoritative for the user's live voice server -- re-sync these two
# values here if the user changes it there). config.py also falls back to
# reading that reference .env directly if these two are left blank/unset,
# so keeping this checked-in copy in sync is a convenience, not a hard
# requirement.
VOICE_SERVER_URL=https://dreamboat-bleep-childhood.ngrok-free.dev/voice
VOICE_SERVER_API_KEY=VWIyaCk-SG9xaTMsvmH6ATXnrA6fZTA5ZBV8NijBALs
VOICE_CLIENT_SAMPLE_RATE=16000
VOICE_CLIENT_FRAME_MS=30

# --- Logging ---
LOG_LEVEL=INFO
